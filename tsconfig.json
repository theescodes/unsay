{
	// Generated by `wxt prepare`: strict, noUncheckedIndexedAccess, noImplicitOverride,
	// the `@/` aliases and the extension API types.
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		// Type-check the root .js configs and the .mjs scripts too.
		"allowJs": true,
		"checkJs": true,
		// TS 6 defaults `types` to []. Node types are for the config files and scripts;
		// the extension API types come from .wxt/wxt.d.ts.
		"types": ["node"]
	}
}
