# Supply-chain gate: refuse to resolve package versions published fewer than
# 3 days ago. A smash-and-grab compromised release is usually yanked within
# ~72h, and strict-allow-scripts below independently blocks the most common
# malware payload. Requires npm >= 11.10 — OLDER NPM SILENTLY IGNORES THIS KEY,
# so keep local npm current (Node 24 bundles 11.13+).
min-release-age=3

# Exact versions on save (no ^/~ prefixes).
save-exact=true

# Hard-fail any dependency whose install script isn't approved in package.json's
# allowScripts field (advisory notice otherwise). Approve new/bumped script-running
# deps with `npm approve-scripts <pkg>`. Entries are keyed by package NAME, not
# name@version: versioned keys made every Renovate bump of esbuild/lefthook fail
# `npm ci` until someone re-approved by hand. The per-version review moved to the
# bump PR itself (exact pins + min-release-age above); a NEW script-running
# package still hard-fails here. Escape hatch for a stuck install:
# --dangerously-allow-all-scripts (never commit it).
strict-allow-scripts=true

# Refuse to install under a Node/npm outside package.json's `engines` instead of
# warning. Old npm honors THIS key, so it can no longer silently skip
# min-release-age above — it refuses outright (engines requires npm >= 11.10).
engine-strict=true

# Silence the "packages are looking for funding" install notice.
fund=false
